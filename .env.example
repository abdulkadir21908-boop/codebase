# Higgsfield API (optional - for cloud generation)
HIGGSFIELD_API_KEY=your_api_key_here
HIGGSFIELD_API_URL=https://api.higgsfield.ai/v1

# Device Configuration
DEFAULT_DEVICE=cpu
TORCH_NUM_THREADS=4
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# Model Storage
MODEL_CACHE_DIR=./models/cache
MODEL_REGISTRY_PATH=./models/registry.json

# Server Configuration
HOST=0.0.0.0
PORT=7860
WORKERS=1
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT=300

# Inference Optimization
ENABLE_TORCH_COMPILE=true
ENABLE_CHANNELS_LAST=true
USE_FLASH_ATTENTION=false
PRECISION=fp16

# Quantization Settings
DEFAULT_QUANTIZATION=q4_k_m
LLAMA_CPP_PATH=./llama.cpp

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# MCP Server
MCP_ENABLED=true
MCP_HOST=0.0.0.0
MCP_PORT=7861
